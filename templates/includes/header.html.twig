<header role="banner" id="tv-header" class="mb-12 xl:mb-6 sticky top-0 inset-x-0 z-50 bg-primary lg:bg-transparent">
    <div class="flex flex-col-reverse">

        <div id="tv-header__main" class="px-5">
            <div class="py-4 flex justify-between items-center gap-5 w-full">

                {{ page.header }}

                <button class="theme-selector" aria-label="Canvia entre mode fosc i mode clar">
                    <svg class="moon" width="24" height="24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20.74 13.05a8 8 0 0 1-2.07.27 8 8 0 0 1-5.65-2.34 8 8 0 0 1-2.07-7.72 1 1 0 0 0-1.22-1.23 10 10 0 0 0-4.49 2.59 10 10 0 0 0 0 14.14 10 10 0 0 0 7.07 2.93 10 10 0 0 0 7.07-2.93 10 10 0 0 0 2.59-4.5 1 1 0 0 0-1.23-1.21m-2.77 4.3a8 8 0 0 1-5.66 2.34 8 8 0 0 1-5.65-2.35 8 8 0 0 1 0-11.3 8 8 0 0 1 2.06-1.5 10 10 0 0 0 2.89 7.86 10 10 0 0 0 7.84 2.89 8 8 0 0 1-1.48 2.06"/></svg>
                    <svg class="sun" width="24" height="24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6.993 12c0 2.761 2.246 5.007 5.007 5.007s5.007-2.246 5.007-5.007S14.761 6.993 12 6.993 6.993 9.239 6.993 12M12 8.993c1.658 0 3.007 1.349 3.007 3.007S13.658 15.007 12 15.007 8.993 13.658 8.993 12 10.342 8.993 12 8.993M10.998 19h2v3h-2zm0-17h2v3h-2zm-9 9h3v2h-3zm17 0h3v2h-3zM4.219 18.363l2.12-2.122 1.415 1.414-2.12 2.122zM16.24 6.344l2.122-2.122 1.414 1.414-2.122 2.122zM6.342 7.759 4.22 5.637l1.415-1.414 2.12 2.122zm13.434 10.605-1.414 1.414-2.122-2.122 1.414-1.414z"/></svg>
                </button>

                <button class="tv-main-nav__toggle cursor-pointer">
                    <span class="tv-main-nav__toggle__txt sr-only">Mostra el menú principal</span>
                </button>

            </div>
        </div>

        <div class="tv-main-nav__wrapper h-0 overflow-hidden transition-all duration-300 ease-in-out bg-secondary px-5">
            <div class="tv-main-nav p-5 gap-5 text-center text-sm tracking-wide" aria-hidden="true">
                {{ page.mainmenu }}
            </div>
        </div>

    </div>
</header>