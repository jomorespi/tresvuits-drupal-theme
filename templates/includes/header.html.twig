<header role="banner" id="tv-header" class="mb-12 xl:mb-6 sticky top-0 inset-x-0 z-50 bg-primary lg:bg-transparent">
    <div class="flex flex-col-reverse">

        <div id="tv-header__main" class="px-5">
            <div class="py-4 flex justify-between items-center gap-5 w-full">
                {{ page.header }}

                <button class="tv-main-nav__toggle cursor-pointer">
                    <span class="tv-main-nav__toggle__txt sr-only">Mostra el menú principal</span>
                </button>

            </div>
        </div>

        <div class="tv-main-nav__wrapper h-0 overflow-hidden transition-all duration-300 ease-in-out bg-secondary px-5">
            <div class="tv-main-nav p-5 gap-5 text-center text-sm tracking-wide" aria-hidden="true" inert="">
                {{ page.mainmenu }}
            </div>
        </div>

    </div>
</header>